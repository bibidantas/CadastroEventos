<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Views.ConfirmacaoEvento"
             Title="Confirmação"
             BackgroundColor="#F4F1FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Confira os dados do evento" FontSize="24" FontAttributes="Bold"
                   TextColor="#5B3FA0" HorizontalOptions="Center" />

            <!-- Todos os Labels leem o objeto Evento definido como BindingContext da página -->
            <Border Stroke="#5B3FA0" StrokeThickness="1" Padding="15" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Nome, StringFormat='Evento: {0}'}"
                           FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />
                    <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" />
                    <Label Text="{Binding DuracaoDias, StringFormat='Duração: {0} dia(s)'}" />
                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" />
                    <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}" />
                    <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C}'}" />
                    <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C}'}"
                           FontSize="20" FontAttributes="Bold" TextColor="#5B3FA0" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Confirmar cadastro"
                    BackgroundColor="#2E8B57" TextColor="White"
                    CornerRadius="10" HeightRequest="50"
                    Clicked="btn_confirmar_Clicked" />

            <Button Text="Corrigir dados"
                    BackgroundColor="Transparent" TextColor="#5B3FA0"
                    BorderColor="#5B3FA0" BorderWidth="1"
                    CornerRadius="10" HeightRequest="50"
                    Clicked="btn_corrigir_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
