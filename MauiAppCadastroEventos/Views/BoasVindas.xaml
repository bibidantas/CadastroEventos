<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Views.BoasVindas"
             Title="Início"
             BackgroundColor="#F4F1FA">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="🎉" FontSize="64" HorizontalOptions="Center" />

        <Label Text="Bem-vindo(a) ao app de Cadastro de Eventos!"
               FontSize="28" FontAttributes="Bold"
               TextColor="#5B3FA0" HorizontalTextAlignment="Center" />

        <Label Text="Cadastre o seu evento de forma rápida: informe o nome, as datas, o local, o número de participantes e o custo."
               FontSize="16" HorizontalTextAlignment="Center" />

        <Button Text="Começar cadastro"
                BackgroundColor="#5B3FA0" TextColor="White"
                CornerRadius="10" HeightRequest="50"
                Clicked="Button_Clicked" />
    </VerticalStackLayout>
</ContentPage>
