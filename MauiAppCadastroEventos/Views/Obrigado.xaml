<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Views.Obrigado"
             Title="Obrigada"
             NavigationPage.HasBackButton="False"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}"
             BackgroundColor="#F4F1FA">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="✅" FontSize="64" HorizontalOptions="Center" />

        <Label Text="Obrigada!"
               FontSize="32" FontAttributes="Bold"
               TextColor="#5B3FA0" HorizontalOptions="Center" />

        <Label Text="Seu evento foi cadastrado com sucesso."
               FontSize="16" HorizontalTextAlignment="Center" />

        <Button Text="Fazer novo cadastro"
                BackgroundColor="#5B3FA0" TextColor="White"
                CornerRadius="10" HeightRequest="50"
                Clicked="Button_Clicked" />
    </VerticalStackLayout>
</ContentPage>
